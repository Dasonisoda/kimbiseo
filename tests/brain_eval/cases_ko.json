  {"id": "m2", "user": "우리 집 와이파이 이름은 하늘정원이야, 기억해 둬", "expect": {"tool": "remember", "args": {"content": {"contains_any": ["하늘정원"]}}}},
  {"id": "m3", "user": "전에 내가 좋아한다고 한 커피가 뭐였지?", "expect": {"tool": "recall", "args": {"query": {"contains_any": ["커피"]}}}},
