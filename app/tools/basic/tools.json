{
 "묶음": "basic",
 "설명": "기본 도구 10개 — 기억·웹·날씨·컴퓨터 열기·말 빠르기·대기·계산",
 "도구": [
  {
   "type": "function",
   "function": {
    "name": "remember",
    "description": "사용자가 기억해 달라고 한 사실이나 좋아하는 것을 저장한다.",
    "parameters": {
     "type": "object",
     "properties": {
      "content": {
       "type": "string",
       "description": "기억할 내용 한 문장(예: '사용자는 아이스 아메리카노를 좋아한다')"
      }
     },
     "required": [
      "content"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "recall",
    "description": "저장한 기억과 지난 대화(일기·대화 원문)에서 찾는다('전에 내가 뭐라고 했지', '지난주에 무슨 얘기 했지').",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "찾을 말"
      },
      "day": {
       "type": "string",
       "description": "'오늘'·'어제'·'그제'·'지난주'·'이번 주'·'3일 전' 또는 YYYY-MM-DD"
      }
     },
     "required": []
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "forget",
    "description": "사용자가 잊으라고·지우라고 한 기억을 지운다.",
    "parameters": {
     "type": "object",
     "properties": {
      "what": {
       "type": "string",
       "description": "지울 기억에 든 말"
      },
      "all": {
       "type": "boolean",
       "description": "맞는 것이 여러 개일 때 전부 지울지(사용자가 전부라고 했을 때만 true)"
      }
     },
     "required": [
      "what"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "web_search",
    "description": "웹 검색. 지금 가격·뉴스·주가·최근 소식·확실히 모르는 최신 사실을 찾을 때만 쓴다. 상식·설명·잡담에는 쓰지 않는다.",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "검색어(짧게)"
      },
      "count": {
       "type": "integer",
       "description": "결과 개수(기본 5, 최대 8)"
      }
     },
     "required": [
      "query"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "read_page",
    "description": "웹페이지 주소의 본문 글을 읽는다. 사용자가 준 주소나 검색 결과 주소 하나를 읽을 때 쓴다.",
    "parameters": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string",
       "description": "읽을 http/https 주소"
      },
      "find": {
       "type": "string",
       "description": "찾을 말. 있으면 그 말이 든 부분을 먼저 준다"
      }
     },
     "required": [
      "url"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "get_weather",
    "description": "날씨(지금 기온·하늘, 오늘·내일·모레 최고/최저 기온과 비 올 확률). 장소를 말하지 않으면 설정한 기본 장소.",
    "parameters": {
     "type": "object",
     "properties": {
      "place": {
       "type": "string",
       "description": "도시 이름(예: 서울, 부산). 말하지 않았으면 비운다"
      },
      "day": {
       "type": "string",
       "enum": [
        "today",
        "tomorrow",
        "day_after"
       ],
       "description": "특정 날만 원할 때"
      }
     },
     "required": []
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "pc_action",
    "description": "이 컴퓨터에서 웹사이트를 열거나(open_website), 검색 결과 화면을 열거나(search), 정해진 프로그램을 켠다(open_program). '네이버에서/구글에서/유튜브에서 ~ 검색해 줘'처럼 검색할 곳을 말하면 search 로 그 검색 화면을 연다. 허용된 것만 된다.",
    "parameters": {
     "type": "object",
     "properties": {
      "action": {
       "type": "string",
       "enum": [
        "open_website",
        "search",
        "open_program"
       ]
      },
      "site": {
       "type": "string",
       "description": "open_website: 사이트 이름(예: 네이버, 유튜브) 또는 주소"
      },
      "query": {
       "type": "string",
       "description": "search: 검색어"
      },
      "engine": {
       "type": "string",
       "enum": [
        "naver",
        "google",
        "youtube"
       ],
       "description": "search: 검색할 곳(기본 naver)"
      },
      "program": {
       "type": "string",
       "enum": [
        "chrome",
        "edge",
        "notepad",
        "calculator",
        "explorer",
        "paint"
       ],
       "description": "open_program: chrome=크롬, edge=엣지, notepad=메모장(김비서 메모 창), calculator=계산기 프로그램, explorer=파일 탐색기, paint=그림판"
      }
     },
     "required": [
      "action"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "type_text",
    "description": "메모장(김비서 메모 창)에 글을 써 넣는다. 김비서가 띄운 메모 창에만 쓴다(열린 것이 없으면 새로 열어서 씀). 찾은 내용 정리·받아 적기에 쓴다. 다른 프로그램에는 쓰지 않고, 저장은 사용자가 한다.",
    "parameters": {
     "type": "object",
     "properties": {
      "text": {
       "type": "string",
       "description": "써 넣을 글(4000자까지, 줄바꿈 가능)"
      },
      "new_memo": {
       "type": "boolean",
       "description": "새 메모 창을 열어 쓰려면 true"
      }
     },
     "required": [
      "text"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "speech_speed",
    "description": "{이름} 말소리 빠르기. '빠르게'=1.2, '더 빠르게'=1.4, '원래 속도로'·'천천히'=1.0, '한 단계 빠르게/느리게'=faster/slower, '말 속도 몇이야'=status.",
    "parameters": {
     "type": "object",
     "properties": {
      "speed": {
       "type": "string",
       "enum": [
        "1.0",
        "1.2",
        "1.4",
        "faster",
        "slower",
        "status"
       ]
      }
     },
     "required": [
      "speed"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "standby",
    "description": "대화를 끝내고 대기한다. 사용자가 '그만', '이제 됐어', '쉬어', '대기해'처럼 대화를 마칠 때 부른다.",
    "parameters": {
     "type": "object",
     "properties": {},
     "required": []
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "calc",
    "description": "숫자 계산 도구(곱하기·나누기·퍼센트·합계). 숫자 계산은 머리로 하지 말고 이 도구로 한다. '계산기 켜 줘'처럼 계산기 프로그램을 켜라는 말은 이 도구가 아니라 pc_action(open_program, calculator).",
    "parameters": {
     "type": "object",
     "properties": {
      "expression": {
       "type": "string",
       "description": "숫자와 + - * / ( ) 로 쓴 식(예: '37000*4', '250000*15/100')"
      }
     },
     "required": [
      "expression"
     ]
    }
   }
  }
 ]
}